# Dependencies are installed inside the image for the target platform.
# Copying the host's node_modules would overwrite them with macOS binaries.
node_modules

# Regenerated by `bun run build` during the image build.
dist

# Runtime config belongs in `docker run -e` / compose, not baked into a layer.
.env
.env.*

# VCS, CI and editor cruft.
.git
.gitignore
.github
**/.DS_Store

# Not needed to build or run the server.
test
README.md

# Docker's own files.
Dockerfile
.dockerignore
